---
// Hero block: a psql session that types out a query and renders its result set.
// The full highlighted markup is in the HTML, so the page reads correctly with no JS
// or reduced motion; the script only animates it on top.

const name = 'Rahat Ahsan';
const title = 'Data Analyst';

// Plain text is what gets typed out; the highlighted version is what sits in the HTML.
const queryPlain = 'SELECT skill, area\nFROM rahat.skills\nORDER BY area;';
const queryHtml =
  '<span class="kw">SELECT</span> skill, area\n' +
  '<span class="kw">FROM</span> rahat.skills\n' +
  '<span class="kw">ORDER BY</span> area;';

const rows = [
  { skill: 'SQL', area: 'querying & modelling' },
  { skill: 'Python', area: 'analysis & automation' },
  { skill: 'Excel', area: 'budgeting & reporting' },
  { skill: 'Power BI', area: 'dashboards' },
  { skill: 'AWS', area: 'cloud' },
  { skill: 'Azure', area: 'cloud' },
];
---

<section class="sql-hero" data-sql-hero>
  <h1 class="hero-name">{name}</h1>
  <p class="hero-title">{title}</p>

  <div class="sql-panel">
    <div class="sql-bar">
      <span>psql — rahat_db</span>
      <span class="sql-bar-status">connected</span>
    </div>

    <pre class="sql-code" aria-label="SQL query"><code data-typed data-plain={queryPlain} set:html={queryHtml}></code></pre>

    <div class="sql-results" role="table" aria-label="Query result">
      <div class="sql-row sql-head" role="row">
        <span role="columnheader">skill</span>
        <span role="columnheader">area</span>
      </div>
      {rows.map((row) => (
        <div class="sql-row" role="row" data-row>
          <span class="sql-skill" role="cell">{row.skill}</span>
          <span class="sql-area" role="cell">{row.area}</span>
        </div>
      ))}
      <div class="sql-footer">({rows.length} rows)</div>
    </div>
  </div>
</section>

<style>
  .sql-hero {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }

  .hero-name {
    margin: 0;
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--accent-strong);
  }

  .hero-title {
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
  }

  .sql-panel {
    border: 1px solid var(--rule-2);
    background: var(--surface);
    box-shadow: 0 1px 3px var(--shadow-rest);
    margin-top: 10px;
  }

  .sql-bar {
    display: flex;
    justify-content: space-between;
    padding: 9px 16px;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
    color: var(--ink-3);
    font-size: 12px;
  }

  .sql-bar-status {
    color: var(--accent);
  }

  .sql-code {
    margin: 0;
    padding: 18px 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
    min-height: 6.4em;
    white-space: pre;
  }

  .sql-code :global(.kw) {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .sql-results {
    border-top: 1px dashed var(--rule-2);
    padding: 6px 0 12px;
  }

  .sql-row {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) 2fr;
    gap: 16px;
    padding: 8px 20px;
    border-left: 2px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .sql-head {
    color: var(--ink-3);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sql-row:not(.sql-head):hover {
    border-left-color: var(--accent);
    background: var(--accent-active-bg);
    transform: translateX(4px);
  }

  .sql-skill {
    color: var(--ink);
    font-weight: 600;
  }

  .sql-area {
    color: var(--ink-2);
  }

  .sql-footer {
    padding: 10px 20px 0;
    color: var(--ink-3);
    font-size: 12px;
  }

  /* Only hide rows when the script is going to animate them in. */
  :global([data-sql-animate]) .sql-row:not(.sql-head) {
    opacity: 0;
    transform: translateY(4px);
  }
  :global([data-sql-animate]) .sql-row.is-in {
    opacity: 1;
    transform: none;
    transition: opacity 0.35s ease, transform 0.35s ease, border-color 0.2s ease, background 0.2s ease;
  }
  :global([data-sql-animate]) .sql-footer {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  :global([data-sql-animate]) .sql-footer.is-in {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .sql-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .sql-head {
      display: none;
    }
    .sql-code {
      font-size: 13px;
      padding: 14px;
    }
  }
</style>

<script>
  // Types the query, then reveals result rows. Skipped entirely for reduced motion.
  const hero = document.querySelector<HTMLElement>('[data-sql-hero]');
  const code = hero?.querySelector<HTMLElement>('[data-typed]');

  if (hero && code && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const fullHtml = code.innerHTML;
    const plain = code.dataset.plain ?? '';
    const rows = Array.from(hero.querySelectorAll<HTMLElement>('[data-row]'));
    const footer = hero.querySelector<HTMLElement>('.sql-footer');

    hero.setAttribute('data-sql-animate', '');
    code.textContent = '';

    let i = 0;
    const typeNext = () => {
      if (i < plain.length) {
        code.textContent += plain[i++];
        window.setTimeout(typeNext, 22);
        return;
      }
      // Restore the highlighted markup once typing finishes.
      code.innerHTML = fullHtml;
      rows.forEach((row, n) => {
        window.setTimeout(() => row.classList.add('is-in'), 120 * n);
      });
      window.setTimeout(() => footer?.classList.add('is-in'), 120 * rows.length);
    };
    window.setTimeout(typeNext, 400);
  }
</script>
