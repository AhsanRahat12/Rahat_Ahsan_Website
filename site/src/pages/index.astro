---
import '../styles/global.css';

// Real design port from design/MainLight.dc.html (Terminal/CLI, light mode), first pass.
// Still open (see README.md "Open items"): Experience section content, resume PDF,
// Medium blog feed (currently an honest empty state).

const name = 'Rahat Ahsan';
const location = 'Manitoba, Canada';

const roles = ['Systems Engineer', 'Site Reliability Engineer', 'Platform Engineer', 'DevOps Engineer'];
const statusMessages = ['remote / hybrid / in-person', 'open to relocation'];

const navItems = [
  { id: 'about', label: '$ cd about' },
  { id: 'projects', label: '$ cd projects' },
  { id: 'blog', label: '$ cd blog' },
  { id: 'experience', label: '$ cd experience' },
  { id: 'contact', label: '$ cd contact' },
];

const projects = [
  { name: 'home_lab', description: '[one-line description]', status: 'deployed' },
  { name: 'cloud_lab', description: '[one-line description]', status: 'deployed' },
  { name: 'study_app', description: '[one-line description]', status: 'in progress' },
  {
    name: 'rahat_ahsan_website',
    description: 'this site — Astro + Terraform + a guarded chatbot',
    status: 'in progress',
  },
];

const certs = [{ name: 'AWS Solutions Architect Associate (SAA)', status: 'in progress' }];

const socialLinks = [
  { label: 'GITHUB', href: 'https://github.com/AhsanRahat12' },
  { label: 'LINKEDIN', href: 'https://www.linkedin.com/in/rahatahsan/' },
  { label: 'MEDIUM', href: 'https://medium.com/@s.rahatahsan' },
  { label: 'X', href: 'https://x.com/RahatAhsan20' },
];

const aboutParagraphs = [
  `I spend my days as a Data Analyst turning raw production data — timelines, budgets, salary structures for 500+ employees — into decisions people actually act on. That same instinct for turning raw signal into action pulled me into infrastructure: I've built and run Kubernetes clusters on bare metal and in the cloud, with full observability and alerting that catches problems before they become outages. I've replaced manual deployments with GitOps, wired up CI/CD pipelines with testing and vulnerability scanning baked in, and I write up my production incidents publicly.`,
  `That curiosity didn't come from one place. Environmental Science was my undergrad — physics, chemistry, biology, geology, statistics pulling together — and it's where I first learned how things work together as systems. Day to day, I work with databases and Power Query, automating manual processes wherever I can. It was that combination — systems thinking on one side, the itch to automate on the other — that really sparked my curiosity, and I've been building up my skills to make the jump ever since. With help from KubeCraft, a DevOps mentorship community, I taught myself Kubernetes, Docker, CI/CD, Python, and Linux. Now I'm looking for roles where I get to work hands-on with cloud infrastructure and Kubernetes at scale.`,
];

const aboutTagline = 'From soil samples to CI/CD pipelines.';

// Build-time fetch of the Medium RSS feed — no client-side call, no CORS issue.
// See README.md "Architecture notes" for the fuller plan (scheduled rebuild, GitHub fallback).
type BlogPost = { title: string; link: string; date: string; excerpt: string };

async function fetchMediumPosts(handle: string, limit: number): Promise<BlogPost[]> {
  try {
    const res = await fetch(`https://medium.com/feed/${handle}`);
    if (!res.ok) return [];
    const xml = await res.text();
    const items = xml.split('<item>').slice(1, limit + 1);

    return items.map((item) => {
      const title = item.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/)?.[1] ?? 'untitled';
      const link = item.match(/<link>(.*?)<\/link>/)?.[1] ?? '#';
      const pubDate = item.match(/<pubDate>(.*?)<\/pubDate>/)?.[1];
      const date = pubDate
        ? new Date(pubDate).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC',
          })
        : '';
      const content = item.match(/<content:encoded><!\[CDATA\[([\s\S]*?)\]\]><\/content:encoded>/)?.[1] ?? '';
      const text = content.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
      const excerpt = text.length > 140 ? `${text.slice(0, 140).trim()}…` : text;
      return { title, link, date, excerpt };
    });
  } catch {
    return [];
  }
}

const blogPosts = await fetchMediumPosts('@s.rahatahsan', 2);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <div class="status-block">
          <div class="status-label">$ echo $STATUS</div>
          <div class="status-cycle">
            {statusMessages.map((msg) => <span>{msg}</span>)}
          </div>
        </div>

        <div class="photo-block">
          <span class="status-label">$ open portrait.png</span>
          <div class="photo-frame">
            <img src="/images/portrait.jpg" alt={name} width="480" height="354" />
          </div>
          <span class="photo-caption">portrait.png</span>
        </div>

        <nav class="nav" id="nav">
          {navItems.map((item, i) => (
            <button class="nav-item" data-section={item.id} class:list={{ active: i === 0 }}>
              {item.label}
            </button>
          ))}
        </nav>

        <div class="certs-block">
          <div class="status-label">$ certs --list</div>
          {certs.map((cert) => (
            <div class="cert-line">
              &gt; {cert.name} <span class="cert-status">[{cert.status}]</span>
            </div>
          ))}
          <div class="cert-note">CKA / CKAD / CKS planned next — Kubestronaut once complete</div>
        </div>
      </aside>

      <main class="main">
        <div class="header-box">
          <div class="header-name">&gt;_ {name}</div>
          <div class="title-cycle">
            {roles.map((role) => <span>{role}</span>)}
          </div>
          <div class="header-status-row">
            <div class="pwd-line">&gt; /home/<span id="pwd">about</span><span class="cursor"></span></div>
            <a href="#" class="resume-link">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="oklch(40% 0.13 150)" stroke-width="2">
                <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"></path>
              </svg>
              resume.pdf
            </a>
          </div>
        </div>

        <section id="about">
          <div class="section-label">$ cat about.md</div>
          <div class="about-body">
            {aboutParagraphs.map((p) => <p class="about-para">{p}</p>)}
            <p class="about-tagline">{aboutTagline}</p>
          </div>
        </section>

        <section id="projects">
          <div class="section-label">
            <span>$ ls projects/ --scroll</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="oklch(45% 0.02 95)" stroke-width="2">
              <path d="M9 6l6 6-6 6"></path>
            </svg>
          </div>
          <div class="scroller">
            {projects.map((p) => (
              <div class="pcard">
                <div class="pcard-title-row">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="oklch(40% 0.13 150)" stroke-width="2">
                    <path d="M3 7h6l2 2h10v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7z"></path>
                  </svg>
                  <span class="pcard-title">{p.name}</span>
                </div>
                <span class="pcard-desc">{p.description}</span>
                <span class="pcard-status">[{p.status}]</span>
              </div>
            ))}
          </div>
        </section>

        <section id="blog">
          <div class="section-label">$ tail -n 2 blog/*.md</div>
          <div class="blog-list">
            {blogPosts.length === 0 ? (
              <p class="blog-empty">no posts yet — will pull from Medium once connected</p>
            ) : (
              blogPosts.map((post) => (
                <a class="blog-entry" href={post.link} target="_blank" rel="noopener noreferrer">
                  <div class="blog-title-row">
                    <span class="blog-title">{post.title}</span>
                    <span class="blog-date">{post.date}</span>
                  </div>
                  <p class="blog-excerpt">{post.excerpt}</p>
                </a>
              ))
            )}
          </div>
        </section>

        <div class="footer" id="contact">
          <div class="footer-row">
            <div class="prompt-box">
              <span>user@devops:~$</span>
              <input type="text" id="cmd-input" placeholder="cd about" autocomplete="off" />
            </div>
            <div class="contact-links">
              {socialLinks.map((link, i) => (
                <>
                  {i > 0 && <span class="contact-sep">&middot;</span>}
                  <a href={link.href} target="_blank" rel="noopener noreferrer">[{link.label}]</a>
                </>
              ))}
            </div>
          </div>
          <div class="command-error" id="cmd-error" hidden></div>
          <div class="command-hint">type a command, click a line above, or use up/down</div>
        </div>
      </main>
    </div>

    <button class="chat-launcher" id="chat-launcher" aria-label="Open chat assistant">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="oklch(40% 0.13 150)" stroke-width="1.6">
        <path d="M4 5h16v11H9l-4 3v-3H4z"></path>
        <path d="M8 9h8M8 12h5"></path>
      </svg>
      <div class="chat-launcher-dot"></div>
    </button>

    <script>
      const sections = ['about', 'projects', 'blog', 'experience', 'contact'];
      const navButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-item'));
      const pwdEl = document.getElementById('pwd')!;
      const input = document.getElementById('cmd-input') as HTMLInputElement;
      const errorEl = document.getElementById('cmd-error')!;

      let active = 'about';

      function goTo(id: string) {
        active = id;
        pwdEl.textContent = id;
        navButtons.forEach((btn) => {
          btn.classList.toggle('active', btn.dataset.section === id);
        });
        errorEl.hidden = true;
        document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      navButtons.forEach((btn) => {
        btn.addEventListener('click', () => goTo(btn.dataset.section!));
      });

      input.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const raw = input.value.trim().toLowerCase();
        if (raw === '') return;
        const cmd = raw.replace(/^cd\s+/, '');
        if (sections.includes(cmd)) {
          goTo(cmd);
          input.value = '';
        } else {
          errorEl.textContent = `command not found: ${raw}`;
          errorEl.hidden = false;
          input.value = '';
        }
      });

      window.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const idx = sections.indexOf(active);
        const delta = e.key === 'ArrowDown' ? 1 : -1;
        goTo(sections[(idx + delta + sections.length) % sections.length]);
      });

      // Chatbot: not built yet — placeholder so the button isn't dead-silent.
      document.getElementById('chat-launcher')!.addEventListener('click', () => {
        alert('Chatbot not built yet — coming once the site + guardrails (see README.md) are in place.');
      });
    </script>
  </body>
</html>
