---
import '../styles/global.css';
import { profile } from '../data/profile';
import { categories, tools } from '../data/tools';
import { homelab, githubUser } from '../data/homelab';
import { experience } from '../data/experience';
import { projects } from '../data/projects';
import { socialLinks, socialIcons } from '../data/social';

const toolGroups = categories
  .map((category) => ({ category, items: tools.filter((t) => t.category === category) }))
  .filter((group) => group.items.length > 0);

const placeholderCount = 3;
const socialLabel = (label: string) => label.charAt(0) + label.slice(1).toLowerCase();
const [firstName, ...restName] = profile.name.split(' ');
const lastName = restName.join(' ');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — {profile.title}</title>
    <meta name="description" content={profile.intro} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Apply the saved theme before first paint so the page doesn't flash. Light is the default. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="wrap">
      <nav class="nav">
        <a class="monogram" href="#top" aria-label="Back to top">RA</a>
        <div class="nav-links">
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#work">Work</a>
          <a href="#homelab">Homelab</a>
          <a href="#contact">Contact</a>
          <button class="theme-btn" id="theme-toggle" type="button" aria-label="Switch to dark mode">Dark</button>
        </div>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap">
          <div class="mono">{profile.location} — <span class="role-word" id="role-word" data-roles={JSON.stringify(profile.roles)}>{profile.roles[0]}</span></div>
          <div class="ghost" aria-hidden="true">Data</div>
          <h1 class="display"><span class="w">{firstName}</span> <em class="w">{lastName}</em></h1>
          <p class="tagline">{profile.intro}</p>
          <p class="lede">{profile.greeting}</p>
          <div class="hero-actions">
            <a class="btn solid" href="#work">View work</a>
            <a class="btn" href="#contact">Get in touch</a>
          </div>
        </div>
      </section>

      <div class="wrap">
        <section class="about" id="about">
          <div>
            <div class="mono">About</div>
            <img class="about-photo" style="margin-top: 20px;" src="/images/portrait.jpg" alt={profile.name} width="1200" height="1200" />
          </div>
          <div class="about-text">
            {profile.bio.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <div class="edu">
              <div class="edu-degree">{profile.education.degree} <span>· {profile.education.focus}</span></div>
              <div class="edu-school">{profile.education.school}</div>
              <div class="edu-courses">Coursework: {profile.education.courses.join(' · ')}</div>
            </div>
            <dl class="facts">
              {profile.facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.href ? <a class="fact-link" href={fact.href}>{fact.value}</a> : fact.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      </div>

      <section class="tools" id="tools">
        <div class="wrap">
          {toolGroups.map((group) => (
            <div class="tools-group">
              <div class="tools-group-label">{group.category}</div>
              <div class="tools-names">
                {group.items.map((tool, i) => (
                  <>
                    {i > 0 && <span class="tools-dot" aria-hidden="true">·</span>}
                    <span class="tools-name">{tool.name}</span>
                  </>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <div class="wrap">
        <section class="section" id="experience">
          <div class="mono">Experience</div>
          <h2 class="display">Where I&rsquo;ve <em>worked</em></h2>
          <div class="roles">
            {experience.map((role) => (
              <article class="role">
                <div class="role-dates">{role.dates}</div>
                <div>
                  <h3 class="role-title">{role.title}</h3>
                  <p class="role-org">{role.org}</p>
                  <p class="role-story">{role.story}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="section" id="work">
          <div class="mono">Selected work</div>
          <h2 class="display">Projects{projects.length === 0 && <em> in progress</em>}</h2>
          <div class="cards stack">
            {projects.length > 0
              ? projects.map((project, i) => {
                  const Tag = project.href ? 'a' : 'article';
                  return (
                    <Tag class="card" href={project.href}>
                      <div class="card-img">
                        {project.image
                          ? <img src={project.image} alt={project.title} loading="lazy" />
                          : <span class="card-num">{String(i + 1).padStart(2, '0')}</span>}
                      </div>
                      <h3 class="card-title">{project.title}</h3>
                      <p class="card-meta">{project.summary}</p>
                      <p class="card-tags">{project.tools.join(' · ')} — {project.status}</p>
                    </Tag>
                  );
                })
              : Array.from({ length: placeholderCount }, (_, i) => (
                  <article class="card">
                    <div class="card-img"><span class="card-num">{String(i + 1).padStart(2, '0')}</span></div>
                    <h3 class="card-title">Project title</h3>
                    <p class="card-meta">One line on the problem. Tools used. The outcome, in one sentence.</p>
                  </article>
                ))}
          </div>
        </section>

        <section class="section" id="homelab">
          <div class="mono">Homelab</div>
          <h2 class="display">Off <em>the clock</em></h2>
          <p class="lede">{homelab.intro}</p>
          <div class="cards">
            {homelab.projects.map((p, i) => (
              <a class="card" href={`/homelab/${p.slug}`}>
                <div class="card-img">
                  {p.diagram
                    ? <img src={`https://raw.githubusercontent.com/${githubUser}/${p.repo}/HEAD/${p.diagram}`} alt={`${p.name} architecture diagram`} loading="lazy" />
                    : <span class="card-num">{String(i + 1).padStart(2, '0')}</span>}
                </div>
                <h3 class="card-title">{p.name}</h3>
                <p class="card-meta">{p.detail}</p>
              </a>
            ))}
          </div>
        </section>

        <section class="contact" id="contact">
          <div class="mono">Contact</div>
          <a class="display big" href={`mailto:${profile.email}`}>
            Let&rsquo;s talk data. <span class="mail-badge" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" /></svg></span>
          </a>
          <div class="socials">
            <a href={`mailto:${profile.email}`}>
              <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" /></svg>
              <span>Email</span>
            </a>
            {socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={socialIcons[link.label]} /></svg>
                <span>{socialLabel(link.label)}</span>
              </a>
            ))}
          </div>
        </section>

        <footer class="foot">
          <span>{profile.name}</span>
          <a href="#top">Go back to top &uarr;</a>
        </footer>
      </div>
    </main>

    <script is:inline>
      (() => {
        const el = document.getElementById('role-word');
        if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const roles = JSON.parse(el.dataset.roles || '[]');
        if (roles.length < 2) return;
        let i = 0;
        setInterval(() => {
          el.classList.add('out');
          setTimeout(() => {
            i = (i + 1) % roles.length;
            el.textContent = roles[i];
            el.classList.remove('out');
          }, 350);
        }, 4500);
      })();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const apply = (theme) => {
          root.dataset.theme = theme;
          const next = theme === 'dark' ? 'Light' : 'Dark';
          btn.textContent = next;
          btn.setAttribute('aria-label', `Switch to ${next.toLowerCase()} mode`);
        };
        apply(root.dataset.theme === 'dark' ? 'dark' : 'light');
        btn.addEventListener('click', () => {
          const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          apply(theme);
          try {
            localStorage.setItem('theme', theme);
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
