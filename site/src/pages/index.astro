const experienceIntro = 'Skills I picked up, and where I put them to work.';
const certificationsIntro = 'AWS in progress — Kubernetes certs next.';

const certifications = [
  {
    name: 'AWS Solutions Architect Associate (SAA)',
    status: 'in progress',
    description: 'Designing available, cost-efficient, fault-tolerant architectures on AWS.',
  },
  {
    name: 'CKA — Certified Kubernetes Administrator',
    status: 'planned next',
    description: 'Cluster installation, configuration, and troubleshooting — the operator-facing Kubernetes cert.',
  },
  {
