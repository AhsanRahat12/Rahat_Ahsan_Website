// Build-time fetch of the Medium RSS feed — no client-side call, no CORS issue.
// See README.md "Architecture notes" for the fuller plan (scheduled rebuild, GitHub fallback).
type BlogPost = { title: string; link: string; date: string; excerpt: string; readTime: string };

// Average adult silent-reading speed; standard estimate Medium itself uses.
const WORDS_PER_MINUTE = 200;

async function fetchMediumPosts(handle: string, limit: number): Promise<BlogPost[]> {
  try {
    const res = await fetch(`https://medium.com/feed/${handle}`);
    if (!res.ok) return [];
    const xml = await res.text();
    const items = xml.split('<item>').slice(1, limit + 1);

    return items.map((item) => {
      const title = item.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/)?.[1] ?? 'untitled';
      const link = item.match(/<link>(.*?)<\/link>/)?.[1] ?? '#';
      const pubDate = item.match(/<pubDate>(.*?)<\/pubDate>/)?.[1];
      const date = pubDate
        ? new Date(pubDate).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC',
          })
        : '';
      const content = item.match(/<content:encoded><!\[CDATA\[([\s\S]*?)\]\]><\/content:encoded>/)?.[1] ?? '';
      const text = content.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
      const excerpt = text.length > 260 ? `${text.slice(0, 260).trim()}…` : text;
      const wordCount = text.split(/\s+/).filter(Boolean).length;
      const readTime = `${Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE))} min read`;
      return { title, link, date, excerpt, readTime };
    });
  } catch {
    return [];
  }
}

