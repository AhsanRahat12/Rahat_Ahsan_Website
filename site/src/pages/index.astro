const skills = [
  { name: 'Kubernetes', context: 'bare-metal k3s (home_lab) and AKS (cloud_lab), both GitOps-managed' },
  { name: 'GitOps (Flux)', context: 'continuous deployment across home_lab and cloud_lab' },
  { name: 'CI/CD', context: 'Trivy-scanned, tested pipeline in study_app' },
  { name: 'Terraform / IaC', context: 'provisioning cloud_lab on Azure' },
  { name: 'Docker', context: 'containerized dev environment in study_app' },
  {
    name: 'Observability',
    context: 'Prometheus + Grafana on home_lab and cloud_lab; Slack alerts on home_lab, Telegram on cloud_lab',
  },
