          <div class="prompt-box">
            <input
              type="text"
              id="cmd-input"
              placeholder="cd About"
              autocomplete="off"
              data-projects={JSON.stringify(projects.map((p) => ({ slug: p.slug, name: p.name })))}
            />
          </div>
          <div class="command-error" id="cmd-error" hidden></div>
          <div class="command-output" id="cmd-output" hidden></div>
          <div class="command-hint">
            type a command, try "cd About" or "cd Projects/{projects[0]?.name ?? 'Homelab'}" — Tab to autocomplete
          </div>
        </div>
      </aside>

      <main class="main">
        <div class="header-box">
          <div class="header-name">&gt;_ {name}</div>
          <div class="title-cycle">
            {roles.map((role) => <span>{role}</span>)}
          </div>
          <div class="header-status-row">
            <div class="pwd-line">&gt; /home/<span id="pwd">about</span><span class="cursor"></span></div>
            <a href="/resume.pdf" download="Rahat_Ahsan_Resume.pdf" class="resume-link">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" style="stroke: var(--accent)" stroke-width="2">
                <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"></path>
              </svg>
              resume.pdf
            </a>
          </div>

          <div class="skill-badges">
            {skillBadges.map((badge) => (
              <span class="skill-badge" title={badge.label}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={badge.path}></path>
                </svg>
                {badge.label}
              </span>
            ))}
          </div>
        </div>

        <div class="stats-row">
          {impactStats.map((stat) => (
            <div class="stat-tile reveal">
              <span class="stat-value">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))}
        </div>

        <section id="about" class="content-section">
          <h2 class="section-label active">About</h2>
          <div class="about-body">
            <div class="about-photo-frame">
              <img src="/images/portrait.jpg" alt={name} width="480" height="354" />
            </div>
            {aboutParagraphs.map((p) => <p class="about-para">{p}</p>)}
            <p class="about-tagline">{aboutTagline}</p>
          </div>
        </section>

        <section id="projects" class="content-section">
          <h2 class="section-label">Projects</h2>
          <p class="section-intro">{projectsIntro}</p>
          {projects.length === 0 ? (
            <p class="blog-empty">no repos tagged with the "portfolio" topic yet on GitHub</p>
          ) : (
            <div class="scroller">
              {projects.map((p) => (
                <div class="pcard reveal">
                  <a href={`/projects/${p.slug}`} class="pcard-stretched-link" aria-label={`View ${p.name} details`}></a>
                  <div class="pcard-title-row">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="stroke: var(--accent)" stroke-width="2">
                      <path d="M3 7h6l2 2h10v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7z"></path>
                    </svg>
                    <span class="pcard-title">{p.name}</span>
                    <a
                      href={p.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pcard-github-link"
                      aria-label={`${p.name} on GitHub`}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
                      </svg>
                    </a>
                  </div>
                  <span class="pcard-desc">{p.description}</span>
                  <span class="pcard-status">[{p.status}]</span>
                </div>
              ))}
            </div>
          )}
        </section>

        <section id="blog" class="content-section">
          <h2 class="section-label">Blog</h2>
          <p class="section-intro">{blogIntro}</p>
          <div class="blog-list">
            {blogPosts.length === 0 ? (
              <p class="blog-empty">no posts yet — will pull from Medium once connected</p>
            ) : (
              blogPosts.map((post) => (
                <a class="blog-entry reveal" href={post.link} target="_blank" rel="noopener noreferrer">
                  <div class="blog-title-row">
                    <span class="blog-title">{post.title}</span>
                    <span class="blog-meta">{post.date} · {post.readTime}</span>
                  </div>
                  <p class="blog-excerpt">{post.excerpt}</p>
                </a>
              ))
            )}
          </div>
        </section>

        <section id="experience" class="content-section">
          <h2 class="section-label">Experience</h2>
          <p class="section-intro">{experienceIntro}</p>

          <div class="skill-grid">
            {skills.map((s, i) => (
              <div class="skill-item reveal" class:list={{ 'skill-item-last-row': i >= skillLastRowStart }}>
                <span class="skill-name">{s.name}</span>
                <span class="skill-context">{s.context}</span>
                <div class="skill-projects">
                  {s.links.map((link) => (
                    <a
                      class="skill-project-link"
                      href={link.href}
                      target={link.href.startsWith('http') ? '_blank' : undefined}
                      rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                      implemented in: {link.label}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section id="certifications" class="content-section">
          <h2 class="section-label">Certifications</h2>
          <p class="section-intro">{certificationsIntro}</p>
          <div class="cert-roadmap">
            {certifications.map((c) => (
              <div class="cert-entry reveal">
                <div class="cert-entry-row">
                  <span class="cert-entry-name">{c.name}</span>
                  <span class="cert-entry-status">[{c.status}]</span>
                </div>
                <p class="cert-entry-desc">{c.description}</p>
              </div>
            ))}
          </div>
        </section>

        <div class="footer">
          <div class="footer-row">
            <div class="contact-links">
              <span class="contact-links-label">Let's connect:</span>
              {socialLinks.map((link, i) => (
                <>
                  {i > 0 && <span class="contact-sep">&middot;</span>}
                  <a class="contact-link-item" href={link.href} target="_blank" rel="noopener noreferrer">
                    [{link.label}]
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={socialIcons[link.label]}></path>
                    </svg>
                  </a>
                </>
              ))}
            </div>

            <div class="footer-cta">
              <a href="mailto:s.rahatahsan@gmail.com" class="cta-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="stroke: var(--accent)" stroke-width="2">
                  <path d="M4 5h16v14H4z"></path>
                  <path d="M4 6l8 7 8-7"></path>
                </svg>
                Open to new roles — say hello
              </a>
            </div>
          </div>

          <div class="terminal-signoff">
            <div class="status-label">$ logout</div>
            <div class="signoff-message">session ended — thanks for stopping by.</div>
          </div>

          <button class="back-to-top" id="back-to-top">&uarr; back to top</button>
        </div>
      </main>
    </div>

    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
      <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
      </svg>
      <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
    </button>

    <button class="chat-launcher" id="chat-launcher" aria-label="Open chat assistant">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" style="stroke: var(--accent)" stroke-width="1.6">
        <path d="M4 5h16v11H9l-4 3v-3H4z"></path>
        <path d="M8 9h8M8 12h5"></path>
      </svg>
      <div class="chat-launcher-dot"></div>
    </button>

    <script>
      const sections = ['about', 'projects', 'blog', 'experience', 'certifications'];
      const sectionLabels: Record<string, string> = {
        about: 'About',
        projects: 'Projects',
        blog: 'Blog',
        experience: 'Experience',
        certifications: 'Certifications',
      };
      const navButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-item'));
      const pwdEl = document.getElementById('pwd')!;
      const input = document.getElementById('cmd-input') as HTMLInputElement;
      const errorEl = document.getElementById('cmd-error')!;
      const outputEl = document.getElementById('cmd-output')!;
      const projectEntries: { slug: string; name: string }[] = JSON.parse(input.dataset.projects ?? '[]');

      // Properly-cased commands for Tab-completion — matching is case-insensitive,
      // but what gets filled into the input should read like the nav labels.
      // "Projects/" is capitalized to match "cd Projects"; each project name
      // keeps its real GitHub-repo casing (e.g. "Study_App"), not its URL slug.
      const commands = [
        ...sections.map((s) => `cd ${sectionLabels[s]}`),
        ...projectEntries.map((p) => `cd Projects/${p.name}`),
      ];

      // Cycles through matches on repeated Tab presses (like a shell), instead of
      // dumping every candidate into the error line — that read as a thrown error.
      let cycleMatches: string[] = [];
      let cycleIndex = -1;
      let cycleBase = '';

      function resetCycle() {
        cycleMatches = [];
        cycleIndex = -1;
        cycleBase = '';
      }

      function autocomplete() {
        const typed = input.value;
        if (typed === '') return;

        const continuingCycle = cycleMatches.length > 0 && input.value === cycleMatches[cycleIndex];
        if (!continuingCycle) {
          cycleBase = typed;
          cycleMatches = commands.filter((c) => c.toLowerCase().startsWith(typed.toLowerCase()));
          cycleIndex = -1;
        }

        if (cycleMatches.length === 0) return;
        cycleIndex = (cycleIndex + 1) % cycleMatches.length;
        input.value = cycleMatches[cycleIndex];
        errorEl.hidden = true;
      }

      let active = 'about';

      // `id` is null once scrolled past the last section into the footer —
      // nothing in the nav should read as "active" at that point, but `active`/
      // pwd stay frozen on whatever section was last real (like a shell that
      // doesn't change directory just because you scrolled off the bottom).
      function setActive(id: string | null) {
        if (id) {
          active = id;
          pwdEl.textContent = id;
        }
        navButtons.forEach((btn) => {
          btn.classList.toggle('active', id !== null && btn.dataset.section === id);
        });
        document.querySelectorAll<HTMLElement>('.content-section').forEach((section) => {
          const isActive = id !== null && section.id === id;
          section.classList.toggle('dimmed', !isActive);
          section.querySelector('.section-label')?.classList.toggle('active', isActive);
        });
        errorEl.hidden = true;
        outputEl.hidden = true;
      }

      function goTo(id: string) {
        setActive(id);
        document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      navButtons.forEach((btn) => {
        btn.addEventListener('click', () => goTo(btn.dataset.section!));
      });

      // Scrollspy: keep the nav highlight + pwd line honest when the user scrolls
      // manually instead of using click/type/arrow-key nav. Uses each section's
      // position relative to a fixed line near the top of the viewport (the last
      // section whose top has crossed above that line wins) rather than
      // IntersectionObserver bands — bands need enough scroll room *past* a
      // section to register it, which breaks for a short last section (e.g.
      // experience) with little page left below it to scroll into.
      function currentSectionFromScroll(): string | null {
        // A section is "current" once its top has scrolled up to this line. Using
        // the viewport midpoint (rather than a line near the top) keeps the buffer
        // of extra scroll room needed *after* the last section small — a line near
        // the top would need far more page height below the last section than a
        // short trailing footer actually provides.
        const threshold = window.innerHeight * 0.5;
        // The footer is short enough that its own top never reaches the
        // threshold line even at max scroll, so "in the footer" is checked
        // directly as "scrolled to the bottom of the page" instead — the
        // footer being the last element on the page makes those equivalent.
        const scrolledToBottom =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
        if (scrolledToBottom) return null;
        let current = sections[0];
        for (const id of sections) {
          const el = document.getElementById(id);
          if (el && el.getBoundingClientRect().top <= threshold) current = id;
        }
        return current;
      }

      let scrollTicking = false;
      function onScroll() {
        if (scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(() => {
          setActive(currentSectionFromScroll());
          scrollTicking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();

      // Typing (as opposed to a Tab-filled value) always starts a fresh completion.
      input.addEventListener('input', () => {
        if (input.value !== cycleMatches[cycleIndex]) resetCycle();
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          e.preventDefault();
          autocomplete();
          return;
        }
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const raw = input.value.trim().toLowerCase();
        if (raw === '') return;
        const cmd = raw.replace(/^cd\s+/, '').replace(/^projects\//, '');
        resetCycle();
        errorEl.hidden = true;
        outputEl.hidden = true;
        const projectMatch = projectEntries.find((p) => p.name.toLowerCase() === cmd);

        if (sections.includes(cmd)) {
          goTo(cmd);
        } else if (projectMatch) {
          window.location.href = `/projects/${projectMatch.slug}`;
        } else if (cmd.startsWith('sudo')) {
          errorEl.textContent = 'permission denied: nice try.';
          errorEl.hidden = false;
        } else if (cmd === 'whoami') {
          outputEl.textContent = 'guest — but you should hire rahat.';
          outputEl.hidden = false;
        } else if (cmd === 'help') {
          outputEl.textContent = 'hidden commands: sudo · whoami · clear';
          outputEl.hidden = false;
        } else if (cmd === 'clear') {
          // no-op beyond the reset already done above
        } else {
          errorEl.textContent = `command not found: ${raw}`;
          errorEl.hidden = false;
        }
        input.value = '';
      });

      window.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const idx = sections.indexOf(active);
        const delta = e.key === 'ArrowDown' ? 1 : -1;
        goTo(sections[(idx + delta + sections.length) % sections.length]);
      });

      // Chatbot: not built yet — placeholder so the button isn't dead-silent.
      document.getElementById('chat-launcher')!.addEventListener('click', () => {
        alert('Will be implemented soon.');
      });

      // Dark mode toggle — the anti-flash script in <head> already applies the
      // stored preference before first paint; this just handles clicks.
      document.getElementById('theme-toggle')!.addEventListener('click', () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (isDark) {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        }
      });

      document.getElementById('back-to-top')!.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // ---- Boot sequence intro (experimental) --------------------------------
      // Plays once per tab session on first load. Any click/keypress fast-forwards
      // it. Skipped entirely under reduced-motion or on repeat visits this session.
      const bootOverlay = document.getElementById('boot-overlay')!;
      const bootLog = document.getElementById('boot-log')!;
      const bootLines = [
        'booting rahat-ahsan.dev',
        'mounting /home/about',
        'starting kubernetes.service',
        'starting gitops.service (flux)',
        'starting observability.service (prometheus + grafana)',
        'starting coffee.service',
      ];

      function renderBootLine(text: string, cls: string) {
        const div = document.createElement('div');
        div.className = cls;
        div.textContent = text;
        bootLog.appendChild(div);
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const alreadyBooted = sessionStorage.getItem('bootPlayed') === 'true';

      if (alreadyBooted || prefersReducedMotion) {
        bootOverlay.hidden = true;
      } else {
        let bootIndex = 0;
        let bootFinished = false;
        let bootTimer: ReturnType<typeof setTimeout> | undefined;

        function finishBoot() {
          if (bootFinished) return;
          bootFinished = true;
          if (bootTimer) clearTimeout(bootTimer);
          bootOverlay.classList.add('boot-done');
          sessionStorage.setItem('bootPlayed', 'true');
          setTimeout(() => {
            bootOverlay.hidden = true;
          }, 450);
        }

        function playNextBootLine() {
          if (bootIndex >= bootLines.length) {
            renderBootLine('system ready. welcome.', 'boot-line-final');
            bootTimer = setTimeout(finishBoot, 500);
            return;
          }
          renderBootLine(bootLines[bootIndex], 'boot-line-ok');
          bootIndex++;
          bootTimer = setTimeout(playNextBootLine, 220);
        }

        function skipBoot() {
          if (bootFinished) return;
          if (bootTimer) clearTimeout(bootTimer);
          bootLog.innerHTML = '';
          while (bootIndex < bootLines.length) {
            renderBootLine(bootLines[bootIndex], 'boot-line-ok');
            bootIndex++;
          }
          renderBootLine('system ready. welcome.', 'boot-line-final');
          finishBoot();
        }

        bootOverlay.addEventListener('click', skipBoot, { once: true });
        window.addEventListener('keydown', skipBoot, { once: true });
        playNextBootLine();
      }

      // ---- Scroll reveal for cards --------------------------------------------
      // Staggers by position within its own parent so a row of cards fans in
      // left-to-right / top-to-bottom instead of popping in all at once.
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const target = entry.target as HTMLElement;
            const siblings = Array.from(target.parentElement?.children ?? []);
            const position = siblings.indexOf(target);
            target.style.animationDelay = `${Math.max(0, position) * 70}ms`;
            target.classList.add('revealed');
            // Strip the reveal classes entirely once the entrance animation
            // finishes, so nothing is left competing with the element's own
            // `:hover` rules for the `transform` property.
            target.addEventListener(
              'animationend',
              () => {
                target.classList.remove('reveal', 'revealed');
                target.style.animationDelay = '';
              },
              { once: true }
            );
            revealObserver.unobserve(target);
          });
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
    </script>
  </body>
</html>
