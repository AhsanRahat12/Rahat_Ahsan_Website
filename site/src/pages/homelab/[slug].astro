---
import ProjectPage from '../../components/ProjectPage.astro';
import { homelab } from '../../data/homelab';

export function getStaticPaths() {
  return homelab.projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectPage project={project} kicker="Homelab project" backHref="/#homelab" />
